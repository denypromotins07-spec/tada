# Environment Configuration for QuantumHFT
# Copy this file to .env and fill in your actual values

# ===========================================
# BINANCE API CONFIGURATION
# ===========================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_USER=quantumhft
TIMESCALEDB_PASSWORD=quantumhft_secure_password
TIMESCALEDB_DB=quantumhft_timeseries

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

REDPANDA_BROKERS=localhost:9092
REDPANDA_SCHEMA_REGISTRY=localhost:8081

# ===========================================
# AI MODEL PATHS
# ===========================================
MODEL_DIR=./models
ONNX_MODEL_PATH=./models/trading_model.onnx
RL_MODEL_PATH=./models/rl_policy.onnx
SENTIMENT_MODEL_PATH=./models/sentiment_analyzer.onnx

# ===========================================
# HARDWARE ACCELERATION
# ===========================================
# Options: cpu, directml (AMD GPU), rocm (AMD ROCm), openvino (Intel NPU)
INFERENCE_DEVICE=directml
RYPZEN_AI_NPU_ENABLED=true
MAX_MEMORY_GB=14

# ===========================================
# RAY DISTRIBUTED COMPUTING
# ===========================================
RAY_HEAD_NODE=localhost
RAY_DASHBOARD_PORT=8265
RAY_OBJECT_STORE_MEMORY_GB=4

# ===========================================
# SYSTEM CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
ENVIRONMENT=development
ENABLE_TELEMETRY=true
TELEMETRY_PORT=9090

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
FRONTEND_PORT=3000
API_HOST=localhost
API_PORT=8000

# ===========================================
# TRADING CONFIGURATION
# ===========================================
DEFAULT_SYMBOL=BTCUSDT
MAX_POSITION_SIZE_USD=10000
MAX_DAILY_LOSS_USD=500
ENABLE_PAPER_TRADING=true
