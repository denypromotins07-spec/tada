# =============================================================================
# HFT QUANT TRADING SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# HARDWARE CONSTRAINTS (AMD Ryzen AI 5 Laptop - 16GB RAM)
# -----------------------------------------------------------------------------
# Total system memory limit: 14GB (leaving 2GB for host OS)
MAX_SYSTEM_RAM_GB=14
CPU_CORES=6
GPU_ACCELERATION=rocm  # AMD Radeon GPU
NPU_ACCELERATION=vitisai  # AMD Ryzen AI NPU (optional)

# -----------------------------------------------------------------------------
# BINANCE API CONFIGURATION
# -----------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true  # Set to false for production trading
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com

# -----------------------------------------------------------------------------
# DATABASE CONNECTION STRINGS
# -----------------------------------------------------------------------------
QUESTDB_HOST=localhost
QUESTDB_PORT=9000
QUESTDB_USERNAME=admin
QUESTDB_PASSWORD=quest
QUESTDB_DB_NAME=hft_ticks

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# -----------------------------------------------------------------------------
# RAY CLUSTER CONFIGURATION
# -----------------------------------------------------------------------------
RAY_HEAD_HOST=localhost
RAY_HEAD_PORT=6379
RAY_DASHBOARD_PORT=8265
RAY_NUM_CPUS=6
RAY_OBJECT_STORE_MEMORY=2GB

# -----------------------------------------------------------------------------
# RUST CORE CONFIGURATION
# -----------------------------------------------------------------------------
RUST_LOG=info
CPU_AFFINITY=0-3  # Pin Rust core to first 4 cores
RT_PRIORITY=99    # Real-time scheduling priority (1-99)
MEMORY_LOCK=true  # Lock memory pages to prevent swapping

# -----------------------------------------------------------------------------
# STRATEGY CONFIGURATION
# -----------------------------------------------------------------------------
STRATEGY_NAMES=trend_following,mean_reversion,market_making
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
WALK_FORWARD_WINDOWS=10
MONTE_CARLO_SIMULATIONS=1000

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
MAX_POSITION_SIZE_USD=10000
MAX_DAILY_LOSS_USD=500
MAX_LEVERAGE=3.0
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NODE_ENV=development
WS_HEARTBEAT_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# MONITORING & LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090
JAEGER_TRACING=false
